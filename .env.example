# ==============================================================================
# ENVIRONMENT CONFIGURATION - AI PHONE AGENT PLATFORM
# ==============================================================================

# Application Environment
ENVIRONMENT=development
PROJECT_NAME="Configurable AI Phone Agent Platform"
API_V1_STR=/api/v1
SECRET_KEY=change_this_to_a_secure_random_secret_in_production_min_32_chars
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database (MongoDB)
# Local or Atlas connection URI. If left blank or unreachable during standalone tests,
# an in-memory/mock driver fallback can be activated for seamless development.
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=ai_phone_agent_db

# Redis (Background Tasks & Rate Limiting)
REDIS_URL=redis://localhost:6379/0

# Rate Limiting
RATE_LIMIT_PER_MINUTE=120

# CORS
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173"]

# LLM Providers (Configure per business or system fallback)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Embeddings
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536

# Voice Providers
VOICE_PROVIDER=vapi
VAPI_API_KEY=
VAPI_WEBHOOK_SECRET=
RETELL_API_KEY=
RETELL_WEBHOOK_SECRET=

# Telephony & Messaging (Twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Compliance & Storage
DEFAULT_CALLING_HOURS_START=09:00
DEFAULT_CALLING_HOURS_END=19:00
DEFAULT_REGION=IN
ENFORCE_CONSENT_FOR_RECORDING=true
